# Nusxa olib .env deb nomlang va qiymatlarni almashtiring. .env ni git'ga qo'shmang.
OMBORAI_DOMAIN=api.omborai.example.uz
OMBORAI_ENV=prod
POSTGRES_PASSWORD=change-me-strong-password
OMBORAI_APP_PASSWORD=change-me-app-password
