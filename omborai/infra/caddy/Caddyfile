{$OMBORAI_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	log {
		output stdout
		format json
	}
}
