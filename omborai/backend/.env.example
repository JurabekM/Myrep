# Ilova (app) foydalanuvchisi: RLS cheklovli, superuser EMAS
OMBORAI_DATABASE_URL=postgresql+asyncpg://omborai_app:change-me@localhost:5432/omborai
# Migratsiya foydalanuvchisi (jadval egasi)
OMBORAI_MIGRATION_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/omborai
OMBORAI_ENV=dev
# Productionda kamida 32 belgili tasodifiy qiymat bo'lishi shart
OMBORAI_JWT_SECRET=dev-only-change-me-please-32-bytes-min
