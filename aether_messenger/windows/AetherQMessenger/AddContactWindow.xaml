<Window x:Class="AetherQMessenger.AddContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontakt qo'shish" Height="400" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">
    <StackPanel Margin="20">
        <TextBlock Text="Kontaktning karta matnini (QR'dan nusxalangan JSON) joylashtiring:"
                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="CardTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="120" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="Ko'rsatiladigan nom:" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,14,0,6" />
        <TextBox x:Name="DisplayNameTextBox" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <Button Content="Qo'shish" Style="{StaticResource AccentButton}" Click="AddButton_Click" Margin="0,16,0,0" />
    </StackPanel>
</Window>
