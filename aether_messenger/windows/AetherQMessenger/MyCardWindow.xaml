<Window x:Class="AetherQMessenger.MyCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mening kartam" Height="580" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">
    <StackPanel Margin="20">
        <Border Background="White" CornerRadius="12" Padding="16" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="280" Height="280" />
        </Border>
        <TextBlock Text="QR yoki matnni boshqa qurilmaga (mobil/desktop) nusxalab, kontakt sifatida qo'shing."
                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,16,0,10" />
        <TextBox x:Name="CardTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 Height="100" VerticalScrollBarVisibility="Auto" />
        <Button Content="Matnni nusxalash" Style="{StaticResource AccentButton}" Click="CopyButton_Click" Margin="0,12,0,0" />
    </StackPanel>
</Window>
