<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ tizim splash ekrani: ikonka atrofi va fon ilova mavzusidagi to'q rang. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/rostor_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/rostor_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/rostor_bg</item>
    </style>
</resources>
