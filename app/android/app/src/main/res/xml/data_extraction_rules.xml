<?xml version="1.0" encoding="utf-8"?>
<!-- Lokal holat (baza versiyasi, sozlamalar) bulutga ham, boshqa qurilmaga ham ko'chmaydi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
