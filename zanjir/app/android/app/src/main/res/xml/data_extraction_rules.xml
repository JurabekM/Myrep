<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutli zaxira va qurilmadan qurilmaga ko'chirishda ilova ma'lumotlari (SQLite baza, sozlamalar)
     chiqarilmaydi — shaxsiy ma'lumot va audit zanjiri qurilmada qoladi (ADR-0014, MASVS-STORAGE-2). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
