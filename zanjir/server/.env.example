# ZANJIR server sozlamalari (namuna). Haqiqiy qiymatlar faqat `.env` da — u commit qilinmaydi.
# Ilova (runtime) foydalanuvchisi `zanjir_app` roli a'zosi bo'lishi kerak (docs/DEPLOY.md).
ZANJIR_DATABASE_URL=postgresql+asyncpg://zanjir_api:<parol>@localhost:5432/zanjir
# Kamida 32 belgi, tasodifiy: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ZANJIR_JWT_SECRET=<kamida-32-belgili-tasodifiy-satr>
ZANJIR_REGISTRATION_OPEN=false
ZANJIR_CORS_ORIGINS=[]
ZANJIR_LOG_LEVEL=INFO
ZANJIR_SMS_OTP_ENABLED=false
