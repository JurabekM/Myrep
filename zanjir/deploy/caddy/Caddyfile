# ZANJIR — Caddy (11-faza, ADR-0015): TLS (prod — ACME, staging — ichki CA), HSTS, /metrics tashqariga yopiq.
# Kirish logi o'chiq: URL'da QR token bor (ilovaning o'z JSON logi tokenni yashiradi).
{
	admin off
}

{$ZANJIR_DOMAIN} {
	tls {$ZANJIR_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	@metrics path /metrics /metrics/*
	respond @metrics 404
	request_body {
		max_size 6MB
	}
	reverse_proxy api:8000
}
