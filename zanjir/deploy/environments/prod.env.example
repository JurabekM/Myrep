# ZANJIR — prod muhiti (namuna). 🛑 2-inson darvozasi: domen, server, ACME e-pochta va zaxira ochiq kaliti
# operator tomonidan to'ldiriladi. `deploy/zanjir init prod` → environments/prod.env (faqat serverda, 0600, commit qilinmaydi).
# `<...>` qolsa — `up prod` ishlamaydi. Zaxira maxfiy kaliti serverda SAQLANMAYDI (`deploy/zanjir keygen` — operator
# kompyuterida; serverga faqat `age1...` ochiq kalit yoziladi).
ZANJIR_DOMAIN=<domen, masalan zanjir.example.uz>
ZANJIR_TLS=<ACME e-pochta manzili>
ZANJIR_HTTP_PORT=80
ZANJIR_HTTPS_PORT=443
ZANJIR_REGISTRY=docker.io/library
POSTGRES_PASSWORD=@random
ZANJIR_OWNER_PASSWORD=@random
ZANJIR_API_PASSWORD=@random
ZANJIR_JWT_SECRET=@random
ZANJIR_METRICS_TOKEN=@random
# Yangi laboratoriyani faqat operator ochadi (vaqtincha true qilib, RUNBOOK).
ZANJIR_REGISTRATION_OPEN=false
ZANJIR_LOG_LEVEL=INFO
ZANJIR_BACKUP_AGE_RECIPIENT=<age1... ochiq kalit>
ZANJIR_BACKUP_AT=21:30
ZANJIR_BACKUP_KEEP_DAYS=30
ZANJIR_BACKUP_DIR=/var/backups/zanjir
# SMS OTP / SMTP — hali ishlatilmaydi (ADR-0011: interfeys o'chiq); provayder 2-darvozada tanlanadi.
