# ZANJIR — staging muhiti (namuna). `deploy/zanjir init staging` → environments/staging.env (commit qilinmaydi):
# `@random` — tasodifiy maxfiy qiymat, `@age` — zaxira uchun yangi age kalit juftligi (staging uchun; maxfiy kaliti
# environments/staging.age-key ga yoziladi). Parollar faqat [0-9a-f] — URL ichida xavfsiz.
ZANJIR_DOMAIN=localhost
# `internal` — Caddy ichki CA (lokal staging); haqiqiy domen bo'lsa — ACME e-pochta manzili.
ZANJIR_TLS=internal
ZANJIR_HTTP_PORT=8080
ZANJIR_HTTPS_PORT=8443
ZANJIR_REGISTRY=docker.io/library
POSTGRES_PASSWORD=@random
ZANJIR_OWNER_PASSWORD=@random
ZANJIR_API_PASSWORD=@random
ZANJIR_JWT_SECRET=@random
ZANJIR_METRICS_TOKEN=@random
# Staging — sinov uchun: o'zi ro'yxatdan o'tish ochiq, auth chegarasi yuqoriroq (E2E testlari).
ZANJIR_REGISTRATION_OPEN=true
ZANJIR_RATE_LIMIT_AUTH_PER_MINUTE=600
ZANJIR_LOG_LEVEL=INFO
ZANJIR_BACKUP_AGE_RECIPIENT=@age
ZANJIR_BACKUP_AT=21:30
ZANJIR_BACKUP_KEEP_DAYS=7
ZANJIR_BACKUP_DIR=./backups/staging
