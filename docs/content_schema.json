{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barakadaftari.uz/schemas/chapters-v1.json",
  "title": "Baraka Dastur — boblar kontenti (v1)",
  "description": "assets/content/chapters.json sxemasi. Ilovada ContentParser (lib/features/content/domain/content_parser.dart) aynan shu qoidalarni tekshiradi; qo'shimcha qoidalar: id/order/vazifa id takrorlanmaydi, vazifa id bob id bilan boshlanadi. Buzuq bob ilovada o'tkazib yuboriladi.",
  "type": "object",
  "required": ["schemaVersion", "chapters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["uz"],
      "additionalProperties": false,
      "properties": {
        "uz": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 }
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "order", "title", "blocks", "law", "weeklyTasks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/text" },
        "audioUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
        "law": {
          "type": "object",
          "required": ["number", "text"],
          "properties": {
            "number": { "type": "integer" },
            "text": { "$ref": "#/$defs/text" }
          }
        },
        "weeklyTasks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+\\.t[1-3]$" },
              "text": { "$ref": "#/$defs/text" },
              "autoComplete": {
                "enum": [
                  null,
                  "VAULT_OPENED",
                  "VAULT_FIRST_DEPOSIT",
                  "INCOME_SHARED",
                  "AUDIT_COMPLETED",
                  "DAFTAR_PAGE_WRITTEN",
                  "EXPENSE_RECORDED",
                  "SUBSCRIPTIONS_REVIEWED",
                  "ENVELOPE_CREATED",
                  "HAVAS_LIMIT_AGREED",
                  "PRICE_COMPARISON_DONE",
                  "EMERGENCY_TARGET_SET",
                  "DEBT_INVENTORY_COMPLETED",
                  "PAYOFF_PLAN_CREATED",
                  "OFFER_CHECKED",
                  "VENTURE_IDEA_CREATED",
                  "AGREEMENT_SIGNED",
                  "ORAL_AGREEMENT_RECORDED",
                  "ACCOUNT_REVIEW_COMPLETED",
                  "FAMILY_AGREEMENT_CREATED",
                  "HOURLY_VALUE_CALCULATED",
                  "LEARNING_GOAL_SET",
                  "LEARNING_PATH_ADDED",
                  "TEACHING_LOGGED"
                ]
              }
            }
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "enum": ["paragraph", "quote"] },
            "text": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "description": "Oyat, hadis, rivoyat. PENDING — production'da ko'rsatilmaydi (SPEC 3).",
          "required": ["type", "text", "source", "religiousReviewStatus"],
          "properties": {
            "type": { "const": "religious" },
            "text": { "$ref": "#/$defs/text" },
            "source": { "$ref": "#/$defs/text" },
            "religiousReviewStatus": { "enum": ["PENDING", "APPROVED"] }
          }
        }
      ]
    }
  }
}
