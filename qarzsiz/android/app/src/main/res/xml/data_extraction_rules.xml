<?xml version="1.0" encoding="utf-8"?>
<!-- Bulutli zaxira va qurilmadan qurilmaga ko'chirish o'chirilgan: qarz ma'lumoti faqat shu qurilmada. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
