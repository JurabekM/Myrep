{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baraka.uz/spec/interchange/export-format.schema.json",
  "title": "Baraka daftari almashish fayli (.baraka ichidagi JSON)",
  "description": "Shifrlangan konteyner (Argon2id + XChaCha20-Poly1305) ichidagi ochiq matn. Mobil va desktop uchun umumiy. Jadval qatorlari bazadagi ustun nomlari bilan beriladi; pul — minor birlikda butun son; sanalar — YYYY-MM-DD; vaqtlar — ISO 8601 (UTC).",
  "type": "object",
  "required": ["format", "schemaVersion", "exportedAt", "deviceId", "householdId", "tables"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "baraka-interchange" },
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "description": "ISO 8601 vaqt (UTC)" },
    "deviceId": { "type": "string", "minLength": 1 },
    "householdId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "since": {
      "type": ["string", "null"],
      "description": "Inkremental eksport: faqat updated_at (yo'q bo'lsa created_at) shu vaqtdan keyingi yozuvlar; null — to'liq"
    },
    "tables": {
      "type": "object",
      "description": "Kalit — jadval nomi (storage sxemasidagi tartib), qiymat — qatorlar",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/row" }
      },
      "properties": {
        "journal_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/journalEntry" }
        }
      }
    }
  },
  "$defs": {
    "scalar": {
      "description": "Ustun qiymati: null, butun son, satr; BLOB — \"$hex:\" prefiksli hex satr",
      "type": ["null", "integer", "number", "string"]
    },
    "row": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "journalEntry": {
      "type": "object",
      "description": "Append-only jurnal yozuvi; hash = SHA256(prev_hash + \"\\n\" + JCS(entry)) (spec/test-vectors/journal_chain.json)",
      "required": [
        "id",
        "household_id",
        "agreement_id",
        "seq",
        "kind",
        "party_id",
        "amount_minor",
        "currency",
        "entry_date",
        "prev_hash",
        "hash",
        "created_at",
        "origin_device_id"
      ],
      "properties": {
        "id": { "type": "string" },
        "household_id": { "type": "string" },
        "agreement_id": { "type": "string" },
        "seq": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": [
            "OPENING_BALANCE",
            "CONTRIBUTION",
            "PROFIT_DISTRIBUTION",
            "LOAN_PAYMENT",
            "CORRECTION",
            "VENTURE_INCOME",
            "VENTURE_EXPENSE",
            "FORCE_MAJEURE",
            "LOSS_DISTRIBUTION",
            "BUYOUT_PAYMENT"
          ]
        },
        "party_id": { "type": "string", "minLength": 1 },
        "amount_minor": { "type": "integer", "minimum": 1 },
        "currency": { "enum": ["UZS", "USD", "EUR", "RUB"] },
        "entry_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": ["string", "null"] },
        "prev_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "string" },
        "origin_device_id": { "type": "string" }
      },
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    }
  }
}
