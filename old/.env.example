# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-string-of-32plus-chars
ALLOWED_ORIGINS=http://localhost:3000

# --- Databases (docker-compose overrides these for containers) ---
MONGO_DSN=mongodb://localhost:27017
MONGO_DB_NAME=ai_advisor
REDIS_DSN=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI providers (kamida bittasini kiriting; qolganlari ixtiyoriy) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
LLAMA_API_BASE=
LLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_CHAT_MODEL=openai:gpt-4o
DEFAULT_EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=admin
