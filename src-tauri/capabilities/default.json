{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Asosiy oyna uchun minimal ruxsatlar: yadro standarti va faqat ilova commandlari (ma'lumot, PIN, qulflash, moliya). shell, http va fs pluginlari yoqilmagan.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-info",
    "allow-get-security-status",
    "allow-setup-pin",
    "allow-unlock",
    "allow-lock",
    "allow-get-home",
    "allow-list-incomes-this-month",
    "allow-list-recent-incomes",
    "allow-create-income",
    "allow-accept-share",
    "allow-get-vault",
    "allow-respond-progression",
    "allow-set-share-rule",
    "allow-set-initial-balance",
    "allow-withdraw",
    "allow-get-audit",
    "allow-add-audit-expense",
    "allow-mark-unexplained-as-daily",
    "allow-finish-audit",
    "allow-get-whose-money",
    "allow-list-categories",
    "allow-list-obligations",
    "allow-add-obligation",
    "allow-set-obligation-active",
    "allow-list-debts",
    "allow-add-debt",
    "allow-pay-debt"
