# M-Pay Pay Sandbox — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)
# Bu yerda HECH QACHON haqiqiy qiymat saqlanmaydi.

# PostgreSQL (2-faza P2.3, ADR-0018): mpay.toml dagi [database] url_env shu nomga ishora qiladi.
# Parol faqat shu yerda (fayl git'ga tushmaydi).
MPAY_DATABASE_URL=postgres://mpay:<parol>@127.0.0.1:5432/mpay

# Shield roli kaliti (API instansiyalari: [shield.remote] key_env; Shield: [[auth.keys]] role = "shield" — ADR-0019)
MPAY_SHIELD_KEY=<shield-kaliti>

# Konfiguratsiya fayli yo'li
MPAY_CONFIG=.mpay/mpay.toml

# Log darajasi (tracing EnvFilter sintaksisi)
RUST_LOG=info,mpay=debug

# KeyStore: "memory" yoki "pkcs11"
MPAY_KEYSTORE=memory

# memory backend uchun dev-urug' (64 hex belgi). `mpay-server init` generatsiya qiladi.
# Faqat sandbox! Production'da memory backend ishlatilmaydi.
MPAY_DEV_MASTER_SEED=<64-hex-belgi>

# pkcs11 backend
MPAY_PKCS11_LIB=/usr/lib/softhsm/libsofthsm2.so
MPAY_PKCS11_TOKEN_LABEL=mpay-sandbox
MPAY_PKCS11_PIN=<user-pin>
# Parallel HSM sessiyalari (1–64, standart 4; ADR-0017)
MPAY_PKCS11_SESSIONS=4

# OTP SMS shlyuzi tokeni ([otp.webhook] token_env; 2-faza P2.1, ADR-0016)
MPAY_SMS_TOKEN=<shlyuz-tokeni>
