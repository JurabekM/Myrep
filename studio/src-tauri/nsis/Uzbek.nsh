LangString addOrReinstall ${LANG_UZBEK} "Komponentlarni qo'shish yoki qayta o'rnatish"
LangString alreadyInstalled ${LANG_UZBEK} "Allaqachon o'rnatilgan"
LangString alreadyInstalledLong ${LANG_UZBEK} "${PRODUCTNAME} ${VERSION} allaqachon o'rnatilgan. Bajariladigan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString appRunning ${LANG_UZBEK} "{{product_name}} ishlab turibdi! Avval uni yoping, keyin qayta urinib ko'ring."
LangString appRunningOkKill ${LANG_UZBEK} "{{product_name}} ishlab turibdi!$\nUni yopish uchun OK tugmasini bosing"
LangString chooseMaintenanceOption ${LANG_UZBEK} "Bajariladigan xizmat amalini tanlang."
LangString choowHowToInstall ${LANG_UZBEK} "${PRODUCTNAME} qanday o'rnatilishini tanlang."
LangString createDesktop ${LANG_UZBEK} "Ish stolida yorliq yaratish"
LangString dontUninstall ${LANG_UZBEK} "O'chirmaslik"
LangString dontUninstallDowngrade ${LANG_UZBEK} "O'chirmaslik (bu o'rnatuvchida o'chirmasdan eski versiyaga qaytish taqiqlangan)"
LangString failedToKillApp ${LANG_UZBEK} "{{product_name}} yopilmadi. Avval uni o'zingiz yoping, keyin qayta urinib ko'ring"
LangString installingWebview2 ${LANG_UZBEK} "WebView2 o'rnatilmoqda..."
LangString newerVersionInstalled ${LANG_UZBEK} "${PRODUCTNAME} ning yangiroq versiyasi allaqachon o'rnatilgan! Eski versiyani o'rnatish tavsiya etilmaydi. Baribir o'rnatmoqchi bo'lsangiz, avval joriy versiyani o'chirgan ma'qul. Bajariladigan amalni tanlang va «Keyingi» tugmasini bosing."
LangString older ${LANG_UZBEK} "eskiroq"
LangString olderOrUnknownVersionInstalled ${LANG_UZBEK} "Tizimda ${PRODUCTNAME} ning $R4 versiyasi o'rnatilgan. O'rnatishdan oldin joriy versiyani o'chirish tavsiya etiladi. Bajariladigan amalni tanlang va «Keyingi» tugmasini bosing."
LangString silentDowngrades ${LANG_UZBEK} "Bu o'rnatuvchida eski versiyaga qaytish taqiqlangan, jim rejimda davom etib bo'lmaydi. Grafik o'rnatuvchidan foydalaning.$\n"
LangString unableToUninstall ${LANG_UZBEK} "O'chirib bo'lmadi!"
LangString uninstallApp ${LANG_UZBEK} "${PRODUCTNAME} ni o'chirish"
LangString uninstallBeforeInstalling ${LANG_UZBEK} "O'rnatishdan oldin o'chirish"
LangString unknown ${LANG_UZBEK} "noma'lum"
LangString webview2AbortError ${LANG_UZBEK} "WebView2 o'rnatilmadi! Usiz dastur ishlamaydi. O'rnatuvchini qayta ishga tushirib ko'ring."
LangString webview2DownloadError ${LANG_UZBEK} "Xato: WebView2 yuklab olinmadi - $0"
LangString webview2DownloadSuccess ${LANG_UZBEK} "WebView2 o'rnatuvchisi yuklab olindi"
LangString webview2Downloading ${LANG_UZBEK} "WebView2 o'rnatuvchisi yuklab olinmoqda..."
LangString webview2InstallError ${LANG_UZBEK} "Xato: WebView2 o'rnatilmadi, chiqish kodi $1"
LangString webview2InstallSuccess ${LANG_UZBEK} "WebView2 o'rnatildi"
LangString deleteAppData ${LANG_UZBEK} "Dastur sozlamalarini ham o'chirish (TAMGA jurnali va kalitlari saqlanadi)"
