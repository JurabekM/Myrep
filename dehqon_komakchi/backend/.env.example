# Copy to .env and adjust. Never commit the real .env file.

# --- Database ---
# Local/dev default: SQLite file, zero setup required.
DATABASE_URL=sqlite:///./dehqon.db
# Production example (PostgreSQL). Requires a hosted Postgres instance (see README
# "External accounts needed for production" section for provider suggestions).
# DATABASE_URL=postgresql://dehqon:changeme@localhost:5432/dehqon

# --- Auth / JWT ---
# Generate a real secret for production: `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Auth mode ---
# "demo": OTP is always 123456, no real SMS sent (default, zero external accounts needed).
# "sms": delegates to an SMS_PROVIDER (not implemented; wire in a real gateway before using).
AUTH_OTP_MODE=demo

# --- Third-party providers (all optional; app works fully without any of these) ---
# SMS_PROVIDER_API_KEY=
# WEATHER_PROVIDER_API_KEY=
# CROP_DIAGNOSIS_MODEL_ENDPOINT=

# --- CORS ---
CORS_ALLOW_ORIGINS=*

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_IMAGE_MB=8
