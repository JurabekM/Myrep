<?xml version="1.0" encoding="utf-8"?>
<!-- BARAKA_OILASI 7.6: baza va kalitlar bulutga ham, qurilmadan qurilmaga ham ko'chirilmaydi.
     Zaxira — faqat foydalanuvchi o'zi yaratgan `.baraka` fayl. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
