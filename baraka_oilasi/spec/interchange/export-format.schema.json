{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barakaoilasi.uz/schema/export-format/1",
  "title": ".baraka almashish formati (formatVersion 1)",
  "description": "Yagona sxema: Android (Dart) va desktop bir xil `interchange` qoidalaridan foydalanadi. Fayl: `BARAKA-EXPORT\\n` + sarlavha (bir qator JSON) + `\\n` + XChaCha20-Poly1305 bilan shifrlangan tarkib. Kalit = Argon2id(NFC(parol), salt). AAD = birinchi ikki qator baytlari. Tarkib — JSON Lines: birinchi qator `meta`, keyin `row` qatorlari; har qator kanonik JSON (kalitlar saralangan, bo'shliqsiz, UTF-8). Yozuv xeshi: sha256(canonical({\"r\": data, \"t\": table})). Vektorlar: `vectors.json` (`oracle.py`).",
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "aead",
        "kdf",
        "salt",
        "nonce"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "aead": {
          "const": "xchacha20poly1305"
        },
        "kdf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "mKib",
            "tCost",
            "pCost"
          ],
          "properties": {
            "alg": {
              "const": "argon2id"
            },
            "mKib": {
              "type": "integer",
              "minimum": 8,
              "maximum": 262144
            },
            "tCost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "pCost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{48}$"
        }
      },
      "x-field-order": [
        "formatVersion",
        "aead",
        "kdf",
        "salt",
        "nonce"
      ]
    },
    "metaLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "formatVersion",
        "schemaVersion",
        "householdId",
        "sourceDeviceId",
        "sourceDeviceName",
        "exportId",
        "ackExportId",
        "mode",
        "exportedAt",
        "rowCount"
      ],
      "properties": {
        "kind": {
          "const": "meta"
        },
        "formatVersion": {
          "const": 1
        },
        "schemaVersion": {
          "type": "integer",
          "description": "Manba bazasining `PRAGMA user_version`; qabul qiluvchida bir xil bo'lishi shart."
        },
        "householdId": {
          "type": "string"
        },
        "sourceDeviceId": {
          "type": "string"
        },
        "sourceDeviceName": {
          "type": "string"
        },
        "exportId": {
          "type": "string",
          "description": "Shu eksport identifikatori (UUIDv7)."
        },
        "ackExportId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Manba qurilma oxirgi qabul qilgan, qabul qiluvchining eksporti: shu orqali ikki tomon kelishgan holat (base) tasdiqlanadi."
        },
        "mode": {
          "enum": [
            "FULL",
            "INCREMENTAL",
            "PAIRING"
          ]
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "spaceId"
          ],
          "description": "Rolli qurilma uchun kamaytirilgan fayl (ADR-0003): yangi qurilma rolini shundan biladi.",
          "properties": {
            "role": {
              "enum": [
                "SELLER",
                "ACCOUNTANT"
              ]
            },
            "spaceId": {
              "type": "string"
            }
          }
        }
      }
    },
    "value": {
      "description": "Ustun qiymati: null, butun son (kasr yo'q), satr yoki BLOB.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "b64"
          ],
          "properties": {
            "b64": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        }
      ]
    },
    "rowLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "table",
        "data"
      ],
      "properties": {
        "kind": {
