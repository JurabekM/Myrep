            "kk_delegations",
            "kk_teaching_logs"
          ]
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/metaLine"
    },
